#MONGODB_URI=mongodb://127.0.0.1:27018/andromeda
#ACTIVE_MODULES=server, persistence
ACTIVE_MODULES=server, persistence
ENV=test
PERSISTENCE_DRIVER=sqlite

# By default every test file gets its own private sqlite database file
# (test/andromeda-test-<pid>-<uuid>.sqlite), deleted when that file's process
# exits. Set SINGLE_TEST_DB=true to make every test file share one fixed file
# instead (test/andromeda-test-shared.sqlite) , handy for inspecting it with
# an external sqlite viewer while a run is in progress, or when you're only
# running one test file at a time. Not safe for concurrently-run test files
# in the general case: sql.js's shared-file coordination is best-effort, not
# real multi-process locking.
SINGLE_TEST_DB=true
# Only takes effect when SINGLE_TEST_DB=true: deletes the shared database
# file once, after the whole test run finishes.
#DELETE_SINGLE_DB_ON_FINISH=true