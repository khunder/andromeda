{
  "name": "@andromeda/designer",
  "version": "1.0.0",
  "description": "A lightweight BPMN designer with pure JavaScript",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "bpmn",
    "diagram",
    "modeler",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bpmn-js": "^18.31.0",
    "bpmn-moddle": "^10.3.1",
    "dockview-core": "^8.6.0",
    "moddle-xml": "^12.3.1",
    "monaco-editor": "^0.57.0"
  },
  "type": "module"
}
