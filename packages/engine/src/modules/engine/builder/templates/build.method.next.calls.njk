{% for flow in outgoingSequenceFlows %}
    // each iteration is block-scoped: with 2+ outgoing flows (e.g. a
    // diverging parallel gateway), an un-scoped `let` below would be
    // redeclared in the same function scope and throw a SyntaxError at load
    // time.
    {
    let flowExecutable = true;
    {% if flow.conditionExpression !== '' and flow.conditionExpression !== undefined %}
    // an outgoing flow with a <bpmn:conditionExpression> is only taken when
    // it evaluates truthy, gating both plain conditional flow and exclusive
    // (XOR) gateway branching alike , a flow with no condition is always
    // taken, so plain/parallel-gateway nodes (no conditions) are unaffected.
    flowExecutable = await this.evaluate({{ stringify(flow.conditionExpression.body) }});
    {% endif %}
    if (flowExecutable) {
        // only record a flow event for a flow that was actually taken ,
        // recording it unconditionally would leave a misleading audit trail
        // for a conditioned flow that was never traversed.
        await PersistenceGateway.createFlowEvent(this.createFlowEvent('{{ flow.id }}'));
        this.callFunction({{ flow.targetNodeMethodSignature }} , __localMethodContext, {incomingFlowId: '{{ flow.id }}' });
    }
    }
{% endfor %}
