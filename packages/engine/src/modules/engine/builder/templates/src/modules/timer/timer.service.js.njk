import {AndromedaLogger} from "../../config/andromeda-logger.js";
import {PersistenceGateway} from "../persistence/persistence-gateway.js";
import {ServiceRegistry} from "../container/registry.js";
import {ContainerService} from "../container/container.service.js";
import {TimerService as DurableTimerService} from "./durable-timers.js";
import {CronExpressionParser} from "cron-parser";
{% for entry in entries %}
import { TimerModel as {{ entry.processDef }}TimerModel } from "{{ entry.timerModelImportPath }}";
{% endfor %}

const Logger = new AndromedaLogger();

// how long a claim lasts before another replica may take it over - see
// durable-timers.js's own leaseMs doc comment. Comfortably above the
// default pollMs (1s) so ordinary scheduling jitter never causes a
// spurious takeover/retry.
const LEASE_MS = 30_000;

// One TimerService serves every workflow compiled into this container -
// each workflow's own {processDef}.timer-model.js only records which nodes
// are timers, tagged here with the processDef they came from so this shared
// scheduler/dispatcher knows which ServiceRegistry entry to dispatch
// through. Backed by durable-timers.js (see EngineTimerRepository for the
// Store plugging it into this project's own persistence layer): its
// lease-based claimDue()/poll loop is both the cross-replica exactly-once
// dispatch *and* the crash-recovery sweep (a claimed row's lease simply
// expires and the next poll re-claims it) for both the Timer Start Event
// and Timer Intermediate Catch Event mechanisms below - no separate
// rescan/stale-release sweeps are needed any more.
export class TimerService {

    /**
     * @type {DurableTimerService}
     */
    static timers;

    static async init() {
        const entries = [
        {% for entry in entries %}
            ...Object.values({{ entry.processDef }}TimerModel).map((timer) => ({...timer, processDef: {{ entry.processDef | dump }}})),
        {% endfor %}
        ];
        if (entries.length === 0) {
            return; // no timer-bearing node in any compiled workflow - nothing to poll for
        }

        TimerService.timers = new DurableTimerService({
            store: PersistenceGateway.getTimerStore(),
            leaseMs: LEASE_MS,
            onError: (error, context) => Logger.error(`timer service error (${JSON.stringify(context)}): ${error.message || error}`),
        });
        TimerService.timers.on('start', (timer) => TimerService.createInstance(timer.payload.processDef));
        TimerService.timers.on('cron-start', (timer) => TimerService.fireCronStart(timer));
        TimerService.timers.on('catch', (timer) => TimerService.resumeCatchEvent(timer));

        await TimerService.timers.start();

        const startTimers = entries.filter((timer) => timer.kind === 'start');
        for (const timer of startTimers) {
            if (timer.iso) {
                // ISO 8601 cycles are fixed-interval, so durable-timers.js
                // tracks the recurrence natively - a fixed id plus
                // insert-if-absent means every replica calling this at boot
                // only ever creates one row (see durable-timers.js's own
                // doc comment).
                await TimerService.timers.schedule({
                    id: `start:${timer.processDef}:${timer.id}`,
                    type: 'start',
                    iso: timer.iso,
                    payload: {nodeId: timer.id, processDef: timer.processDef},
                });
            } else {
                await TimerService.scheduleNextCronStart(timer.processDef, timer.id, timer.cron, new Date());
            }
        }
    }

    /**
     * A cron timeCycle doesn't fit durable-timers.js's fixed-interval
     * `everyMs` (a calendar schedule like "0 9 * * *" has no constant
     * period), so each occurrence is scheduled as its own one-shot timer,
     * computed from the cron expression and re-scheduled by
     * fireCronStart() every time one fires - the same self-rescheduling-
     * chain pattern this container's old rescan-waiting-jobs/release-stale-
     * jobs system jobs used. The id is seeded from the occurrence's own due
     * time, so every replica racing to schedule the *same* occurrence (at
     * boot, or immediately after a fire) converges on one row via
     * insert-if-absent instead of each creating its own.
     * @param {string} processDef
     * @param {string} nodeId
     * @param {string} cronExpression
     * @param {Date} from - compute the next occurrence strictly after this
     */
    static async scheduleNextCronStart(processDef, nodeId, cronExpression, from) {
        const next = CronExpressionParser.parse(cronExpression, {currentDate: from, tz: 'UTC'}).next().toDate();
        await TimerService.timers.schedule({
            id: `start:${processDef}:${nodeId}:${next.getTime()}`,
            type: 'cron-start',
            at: next,
            payload: {nodeId, processDef, cron: cronExpression},
        });
    }

    static async fireCronStart(timer) {
        await TimerService.createInstance(timer.payload.processDef);
        await TimerService.scheduleNextCronStart(timer.payload.processDef, timer.payload.nodeId, timer.payload.cron, new Date());
    }

    /**
     * Fires on every container replica running this deployment at (roughly)
     * the same wall-clock moment - durable-timers.js's lease claim is the HA
     * mechanism that guarantees only one replica's handler actually runs
     * for a given occurrence.
     * @param {string} processDef
     */
    static async createInstance(processDef) {
        const registryEntry = ServiceRegistry[processDef];
        if (!registryEntry) {
            Logger.error(`timer service: unknown processDef ${processDef}`);
            return;
        }
        Logger.info(`timer start event fired (${processDef}), creating a new process instance`);
        const instance = await registryEntry.service.createInstance();
        // not a Promise to await/catch - bootstrap() itself fires the node
        // method as a non-awaited, internally-caught background task (see
        // start.node.processor.js's injected `this.fn_<id>().catch(...)`),
        // same as a manual POST /start's call to bootstrap().
        instance.bootstrap({});
    }

    /**
     * Resumes a process instance waiting at a timer intermediate catch
     * event - the automatic-firing equivalent of POST /signal. Scheduled
     * once, with `at` set to the node's computed `__timerDueAt` (see
     * catch-event.processor.js's alternateBody codegen), by
     * enqueueCatchResume() the moment the process instance actually arrives
     * at the node - not polled for on a fixed interval.
     *
     * closeFlowEventIfActive()'s atomic conditional close is the real,
     * ultimate gate here (same as it is for POST /signal): it's what makes
     * it safe for a manual /signal call and this timer to race for the same
     * node without either needing to know about the other, independent of
     * durable-timers.js's own lease (which only guarantees one container
     * replica's TimerService runs this handler for a given firing).
     * @param {object} timer - payload: {nodeId, processInstanceId, processDef}
     */
    static async resumeCatchEvent(timer) {
        const {nodeId, processInstanceId, processDef} = timer.payload;
        const registryEntry = ServiceRegistry[processDef];
        if (!registryEntry) {
            Logger.error(`timer catch resume: unknown processDef ${processDef}`);
            return;
        }
        const {service, workflowModel} = registryEntry;

        const pendingFlow = Object.values(workflowModel).find(
            (flow) => flow.target && flow.target.id === nodeId
        );
        if (!pendingFlow) {
            Logger.error(`timer catch resume: node ${nodeId} is not a known node in workflow ${processDef}`);
            return;
        }

        const closedFlowEvent = await PersistenceGateway.closeFlowEventIfActive({processInstanceId, flowId: pendingFlow.id});
        if (!closedFlowEvent) {
            // already resumed - by a manual /signal call, most likely
            Logger.debug(`timer catch resume: ${processInstanceId}/${nodeId} already resumed`);
            return;
        }
        await PersistenceGateway.closeTask({processInstanceId, nodeId}).catch((error) => { Logger.error(error); });

        let processInstance = ContainerService.getInstance().processInstances[processInstanceId];
        if (!processInstance) {
            processInstance = await service.restoreInstance(processInstanceId);
        }
        if (!processInstance) {
            Logger.error(`timer catch resume: process instance ${processInstanceId} was not found or is no longer active`);
            return;
        }

        Logger.info(`timer catch event ${nodeId} (${processDef}) due, resuming process instance ${processInstanceId}`);
        processInstance[`fn_${nodeId}`]({executeBody: true, id: pendingFlow.id})
            .catch((error) => { Logger.error(error); });
    }

    /**
     * Schedules a timer catch event's resume for a specific due time -
     * called once, the moment a process instance first arrives at a timer
     * intermediate catch event (catch-event.processor.js's codegen), not
     * from a periodic sweep. No fixed id: a given (processInstanceId,
     * nodeId) pair is only ever scheduled from this one call site, so
     * durable-timers.js's auto-generated id is enough - unlike the Timer
     * Start Event above, nothing else could race to create the same row.
     * @param {string} nodeId
     * @param {string} processInstanceId
     * @param {Date} dueAt
     * @param {string} processDef - which workflow this node belongs to, so
     *   resumeCatchEvent() can resolve the right ServiceRegistry entry when
     *   it fires
     */
    static async enqueueCatchResume(nodeId, processInstanceId, dueAt, processDef) {
        await TimerService.timers.schedule({
            type: 'catch',
            at: dueAt,
            payload: {nodeId, processInstanceId, processDef},
        });
    }
}

export default TimerService;
