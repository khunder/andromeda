import {ServiceRegistry} from "../modules/container/registry.js";
import ContainerService from "../modules/container/container.service.js";
import {authenticate} from "../modules/auth/oidc.js";
import {Config} from "../config/config.js";
import fs from "fs";

function route (fastify, opts, next) {
    fastify.route(
        {

            method: 'GET',
            url: '/live',
            handler: () => {}
        }
    )

    fastify.route(
        {
            method: 'GET',
            url: '/ready',
            handler: () => {}
        }
    )

    // Lets external callers (the designer, Galaxy) discover which workflow(s)
    // this container serves, since routes are namespaced per processDef
    // (/{processDef}/start etc.) rather than one bare /start. Not folded into
    // /ready itself: @gquittet/graceful-server (see web.module.js) intercepts
    // /live and /ready at the raw HTTP layer before they ever reach fastify's
    // router, so a fastify-level handler on those exact paths is unreachable.
    fastify.route(
        {
            method: 'GET',
            url: '/api/process-defs',
            handler: () => ({processDefs: Object.keys(ServiceRegistry)})
        }
    )

    // Lets a caller that already has this container's host/port (e.g. from
    // Galaxy) query its id/version/processDefs directly, without going back
    // through the engine that spawned it. Backed by the container module's
    // own ContainerService (see container.service.js), not read here.
    fastify.route(
        {
            method: 'GET',
            url: '/api/containers',
            handler: () => ContainerService.getInfo()
        }
    )

    // The BPMN a workflow was generated from (deployment-metadata.json's
    // `bpmn`, written at compile time) - Galaxy and the designer draw a
    // process instance's progress on it. 404 for containers compiled before.
    fastify.route(
        {
            method: 'GET',
            url: '/api/bpmn/:processDef',
            handler: async (request, reply) => {
                const deploymentRoot = new URL('../../', import.meta.url);
                let metadata = {};
                try {
                    metadata = JSON.parse(await fs.promises.readFile(new URL('deployment-metadata.json', deploymentRoot), 'utf8'));
                } catch {
                    // no metadata - treated as no BPMN below
                }
                const file = metadata.bpmn?.[request.params.processDef];
                if (!file || file.includes('..')) {
                    reply.code(404);
                    return {message: `no BPMN kept for ${request.params.processDef} - recompile the container`};
                }
                reply.type('application/xml');
                return fs.promises.readFile(new URL(file, deploymentRoot), 'utf8');
            }
        }
    )

    // Validates the caller's bearer token against the OIDC provider and says
    // who they are and which roles they hold (see src/modules/auth) - 401 for
    // a missing/invalid token when OIDC is on.
    fastify.route(
        {
            method: 'GET',
            url: '/api/auth/me',
            handler: async (request) => {
                const principal = await authenticate(request);
                return {
                    oidcEnabled: Config.getInstance().oidcEnabled,
                    adminRole: Config.getInstance().oidcAdminRole,
                    ...principal,
                };
            }
        }
    )
    next();
}

export default route;