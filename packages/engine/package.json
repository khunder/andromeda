{
  "name": "@andromeda/engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Mico Service Bpmn generator",
  "main": "index.js",
  "scripts": {
    "start": "nodemon bootstrap.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:unit": "vitest run src/**/*.unit.test.js",
    "test:int": "vitest run src/**/*.int.test.js",
    "test:e2e": "vitest run test/e2e/**/*.test.js",
    "posttest": "kill-port --port 27018",
    "cover": "npm run test:coverage",
    "test:mocha:int": "mocha --config=.mocharc.int.cjs '**\\*.int.test.js'",
    "test:integration:exec": "npx ava --config ava.integration-tests.config.js & npm run posttest"
  },
  "author": "Zied Ben Rhouma",
  "license": "ISC",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@gquittet/graceful-server": "^3.0.0",
    "ajv": "^8.11.0",
    "axios": "1.11.0",
    "bpmn-moddle": "^7.1.2",
    "deepmerge": "^4.2.2",
    "dotenv": "^16.0.0",
    "fastify": "^5.6.1",
    "fastify-multer": "^2.0.2",
    "fastify-oas": "^3.0.8",
    "forever": "^4.0.3",
    "form-data": "^4.0.0",
    "md5": "^2.3.0",
    "mongoose": "^6.2.10",
    "node-cron": "^4.6.0",
    "node-ipc": "^10.0.2",
    "nunjucks": "^3.2.3",
    "pino": "^9.9.4",
    "pino-pretty": "^13.1.1",
    "sql.js": "^1.14.1",
    "swagger-ui": "^4.10.3",
    "ts-morph": "^14.0.0",
    "uuid": "^8.3.2",
    "yaml": "^2.0.1"
  },
  "devDependencies": {
    "@types/bpmn-moddle": "^5.1.6",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "fastify-plugin": "^3.0.1",
    "happy-dom": "^18.0.1",
    "kill-port": "^1.6.1",
    "node-dev": "^7.4.2",
    "nodemon": "^2.0.15",
    "npm-run-all": "^4.1.5",
    "ps-list": "^8.1.0",
    "rimraf": "^3.0.2",
    "sinon": "^13.0.2",
    "vitest": "^3.2.4"
  }
}
