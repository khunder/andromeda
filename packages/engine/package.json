{
  "name": "@andromeda/engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Mico Service Bpmn generator",
  "main": "index.js",
  "scripts": {
    "start": "node bootstrap.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:unit": "vitest run src/**/*.unit.test.js",
    "test:int": "vitest run src/**/*.int.test.js",
    "test:e2e": "vitest run test/e2e/**/*.test.js",
    "posttest": "kill-port --port 27018",
    "cover": "npm run test:coverage",
    "test:mocha:int": "mocha --config=.mocharc.int.cjs '**\\*.int.test.js'",
    "test:integration:exec": "npx ava --config ava.integration-tests.config.js & npm run posttest"
  },
  "author": "Zied Ben Rhouma",
  "license": "ISC",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@gquittet/graceful-server": "^6.1.1",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "bpmn-moddle": "^10.3.1",
    "cron-parser": "^5.10.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "forever": "^4.0.3",
    "form-data": "^4.0.6",
    "jose": "^6.2.12",
    "md5": "^2.3.0",
    "mongoose": "^9.11.2",
    "node-ipc": "10.1.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sql.js": "^1.15.0",
    "ts-morph": "^28.0.0",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bpmn-moddle": "^10.0.0",
    "@vitest/ui": "^5.0.5",
    "c8": "^12.0.0",
    "fastify-plugin": "^6.0.1",
    "happy-dom": "^21.0.3",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^11.3.0",
    "node-dev": "^8.0.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "ps-list": "^9.0.0",
    "sinon": "^22.1.0",
    "vitest": "^5.0.5"
  }
}
