import {Variable} from "../model/variable.js";
import {PersistenceGateway} from "../modules/persistence/persistence-gateway.js";
import {Config} from "../config/config.js";

export class {{ ProcessDef }}ProcessInstanceContext {
{% for var in processVariables %}
    #{{ var.name }} = new Variable('{{ var.name }}', '{{ var.type }}');
{% endfor %}

    __variablesRef = [{% for var in processVariables %}this.#{{ var.name }},{% endfor %}]

    constructor(processInstanceService) {
        this.processInstanceService = processInstanceService;
    }
{% for var in processVariables %}
    get {{ var.name }}() { return this.#{{ var.name }}.value; }
    set {{ var.name }}(val) { this.#{{ var.name }}.value = val; }
{% endfor %}

    // Flattens the private #variable fields into a plain, structured-clonable object so it can be
    // handed to a worker_threads Worker as `workerData` (worker script tasks run untrusted BPMN
    // script bodies in an isolated thread and must never see this instance or its live references).
    toPlainObject(){
        return this.__variablesRef.reduce((snapshot, variable) => {
            snapshot[variable.name] = variable.value;
            return snapshot;
        }, {});
    }

    // Merges a worker's returned variable snapshot back onto this instance via the real setters
    // (so Variable dirty-tracking still fires for saveContext()). Iterates our own known variable
    // names and looks each up in `snapshot`, rather than iterating `snapshot`'s keys and assigning
    // them - this is what stops a malicious/buggy script task from smuggling back extra keys
    // (e.g. __proto__) and polluting anything beyond the declared process variables.
    applySnapshot(snapshot){
        if (!snapshot) {
            return;
        }
        this.__variablesRef.forEach((variable) => {
            if (Object.prototype.hasOwnProperty.call(snapshot, variable.name)) {
                this[variable.name] = snapshot[variable.name];
            }
        });
    }

    // Rehydrates variable values from persistence — used when a paused process
    // instance is no longer live in this container's memory (e.g. after a
    // restart) and has to be reconstructed before it can be resumed. Inspired
    // by jsflow's ProcessModel.restoreVariableValues(): read every persisted
    // variable row for this instance and, for each one this workflow actually
    // declares, assign it through the real setter (so it gets transcoded to
    // its declared type the same way any other assignment would) and mark it
    // clean immediately - it's not a new change, it's what's already saved.
    async restoreVariableValues(){
        const persistedVariables = await PersistenceGateway.getVariables({
            processInstanceId: this.processInstanceService.processInstanceId,
        });
        persistedVariables.forEach((persisted) => {
            const variable = this.__variablesRef.find((v) => v.name === persisted.name);
            if (variable) {
                variable.value = persisted.value;
                variable.resetStatus();
            }
        });
    }

    async saveContext(){
        const dirtyVariables = this.__variablesRef.filter(variable => variable.needToSave());
        if (dirtyVariables.length === 0) {
            return;
        }
        await PersistenceGateway.saveVariables({
            processInstanceId: this.processInstanceService.processInstanceId,
            processDef: '{{ ProcessDef }}',
            deploymentId: Config.getInstance().deploymentId,
            variables: dirtyVariables.map(variable => ({name: variable.name, type: variable.type, value: variable.value})),
        });
        dirtyVariables.forEach(variable => variable.resetStatus());
    }

}

