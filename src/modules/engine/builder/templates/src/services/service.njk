import  {AndromedaLogger} from "../config/andromeda-logger.js";
const Logger = new AndromedaLogger();
import {v4} from "uuid";
import { {{ ProcessDef }}ProcessInstanceContext} from "./{{ ProcessDef.toLowerCase() }}.process-instance-context.js";
import {PersistenceGateway} from "../modules/persistence/persistence-gateway.js";
import {ContainerService} from "../modules/container/container.service.js";
import {WorkflowModel} from "../modules/container/workflow-model.js";
import {Config} from "../config/config.js";
import {Worker} from "node:worker_threads";

// Script task bodies come straight from the BPMN diagram - arbitrary, author-supplied JS - so they
// run inside a worker_threads Worker (separate V8 isolate/global scope) rather than inline in this
// service. That gets us: no access to live objects on the main thread (workerData/postMessage go
// through structured clone, i.e. copies, not references), and a script that throws/hangs/crashes
// only takes down its own worker instead of the whole container process.
const SCRIPT_TASK_WORKER_SOURCE = String.raw`
import { parentPort, workerData } from "node:worker_threads";

async function run() {
    const variables = workerData.variables || {};
    const scriptThis = { variables };
    const script = new Function(
        "variables",
        "\"use strict\";\nreturn (async function() {\n" + workerData.script + "\n}).call(this);\n",
    );

    await script.call(scriptThis, variables);
    parentPort.postMessage({ variables: scriptThis.variables });
}

run().catch((error) => {
    parentPort.postMessage({
        error: {
            message: error && error.message ? error.message : String(error),
            stack: error && error.stack ? error.stack : undefined,
            name: error && error.name ? error.name : "Error",
        },
    });
});
`;

class {{ServiceClassName}} {

    processInstanceId
    // exposed as `this.variables` so script tasks can read/write process
    // variables directly, e.g. `this.variables.age = 23;`
    variables = new {{ ProcessDef }}ProcessInstanceContext(this);

    bootstrap(incomingVariables){
        if (incomingVariables) {
            Object.keys(incomingVariables).forEach((key) => {
                if (key in this.variables) {
                    this.variables[key] = incomingVariables[key];
                }
            });
        }
    }

    constructor(processInstanceId)
    {
        if (processInstanceId) {
            // in case we resume a process instance after a container restart
            this.processInstanceId = processInstanceId;
            // this.flowService = new TestFlowService(this.id);
        } else {
            this.processInstanceId = v4();
            // this.flowService = new TestFlowService(this.id);
        }

    }

    static async createInstance(processInstanceId)
    {
        try{
            const instance = new {{ServiceClassName}}(processInstanceId)
            await PersistenceGateway.newProcessInstance({
                processInstanceId: instance.processInstanceId,
                deploymentId: Config.getInstance().deploymentId,
                processDef: '{{ ProcessDef }}',
                containerId: ContainerService.containerId
            });
            ContainerService.getInstance().lock(instance)
            return instance;
        }
        catch(e){
            Logger.error(e);
        }
    }

    // Reconstructs a process instance that's no longer live in this
    // container's memory (e.g. after a restart) from persisted state, so a
    // /signal call can resume it from a paused catch event. Returns null if
    // the instance doesn't exist or isn't Active (0) — a completed/aborted
    // instance is never restored. Inspired by jsflow's createInstance(id)
    // restore path (restoreProcessInstanceFormPersistentStore /
    // getProcessInstanceStatus / variables.restoreVariableValues), adapted
    // since Andromeda tracks two-phase "waiting" state via FlowEvent rather
    // than a dedicated per-node status map.
    static async restoreInstance(processInstanceId)
    {
        try{
            const persisted = await PersistenceGateway.getProcessInstance({processInstanceId});
            if (!persisted || persisted.status !== 0) {
                return null;
            }
            const instance = new {{ServiceClassName}}(processInstanceId);
            await instance.variables.restoreVariableValues();
            ContainerService.getInstance().lock(instance);
            return instance;
        }
        catch(e){
            Logger.error(e);
            return null;
        }
    }

    async close(){
          try{
            ContainerService.getInstance().lock(this);
            await PersistenceGateway.closeProcessInstance({
                processInstanceId: this.processInstanceId,
            });
        }
        catch(e){
            Logger.error(e);
        }
    }

    isTwoPhaseComponent(type){
        return type === "IntermediateCatchEvent" || type === "HumanTask"
    }

    async evaluate(expression) {
        try {
          return eval(`${expression};`);
        }catch (e) {
          Logger.error(e);
          throw e;
        }
    }

    async runScriptTaskInWorker(scriptBody, __localMethodContext) {
        const variables = this.variables.toPlainObject();
        const result = await new Promise((resolve, reject) => {
            const worker = new Worker(SCRIPT_TASK_WORKER_SOURCE, {
                eval: true,
                workerData: {
                    script: scriptBody || "",
                    variables,
                    context: __localMethodContext,
                },
            });

            worker.once("message", (message) => {
                if (message?.error) {
                    const error = new Error(message.error.message);
                    error.name = message.error.name;
                    error.stack = message.error.stack;
                    reject(error);
                    return;
                }
                resolve(message);
            });
            worker.once("error", reject);
            worker.once("exit", (code) => {
                if (code !== 0) {
                    reject(new Error(`Script task worker stopped with exit code ${code}`));
                }
            });
        });

        this.variables.applySnapshot(result.variables);
    }

    createFlowEvent(flowEventId){
        let flowEvent = { processInstanceId: this.processInstanceId, flowId: flowEventId, status: 1 };
        if(WorkflowModel[flowEventId] && this.isTwoPhaseComponent(WorkflowModel[flowEventId].target.$type) ){
            flowEvent.status = 0;
        }

        if(WorkflowModel[flowEventId] && this[`customize${WorkflowModel[flowEventId].target.$type}FlowEvent`]){
            this[`customize${WorkflowModel[flowEventId].target.$type}FlowEvent`](flowEvent);
        }

        return flowEvent;

    }

    async failProcessInstance(flowId, __localContext){
         await PersistenceGateway.failFlowEvent({
                processInstanceId: this.processInstanceId,
                flowId: flowId
            });
    }

    canPassParallelGateway(gatewayMap)
    {
        Logger.trace(`canPassParallelGateway called, ${JSON.stringify(Array.from(gatewayMap.entries()))}`);
        if (gatewayMap.size === 0) {
            throw new Error("gateway connections must be more than one");
        }
        // to continue execution, every incoming flow must have arrived (status = 1)
        return Array.from(gatewayMap.values()).every((status) => status === 1);
    }

    callFunction(func, localContext, args  )
    {
        let fnArgs = args || {}
        func.call(this, ...Object.values(fnArgs))
            .catch(async (error) =>
            {
                Logger.error(error);
                await this.failProcessInstance(args.incomingFlowId, localContext);
            }).finally(() =>
            {
            });

    }

}

export default {{ServiceClassName}}




