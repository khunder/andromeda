import  {AndromedaLogger} from "../config/andromeda-logger.js";
import {ContainerService} from "../modules/container/container.service.js";
import {WorkflowModel} from "../modules/container/{{ ProcessDef.toLowerCase() }}.workflow-model.js";
import {PersistenceGateway} from "../modules/persistence/persistence-gateway.js";
const Logger = new AndromedaLogger();

class {{ ControllerClassName }} {

    static start = async (req, res) => {

        try {
            let variables = {};
            if(req.body && req.body.variables){
                // multipart/form-data sends "variables" as a JSON-encoded string field;
                // application/json bodies arrive already parsed as an object
                variables = typeof req.body.variables === 'string'
                    ? JSON.parse(req.body.variables)
                    : req.body.variables;
            }

            if(req.files){
                Object.keys(req.files).forEach( (file) => {
                Logger.debug(`storing file ${file} in persistent storage`);
                });
            }
            const processInstance = await {{ startMethod.name }}ProcessInstanceService.createInstance();
            processInstance.bootstrap(variables);
            return {id: processInstance.processInstanceId};

        } catch (err) {
            Logger.error(err);
            const returnError = new Error();
            returnError.statusCode = 500;
            returnError.message = err;
            returnError.stack=err;
            throw returnError;
        }
    }

    // Resumes a process instance paused at a two-phase node — an
    // intermediate catch event waiting on a signal, or a human task waiting
    // to be completed (see catch-event.processor.js / human-task.node.processor.js
    // for how a process instance ends up here). One generic handler for
    // every such node in this workflow, rather than a route per node: the
    // caller names which one via `nodeId`.
    static signal = async (req, res) => {
        try {
            const body = req.body || {};
            const processInstanceId = body.processInstanceId;
            const nodeId = body.nodeId;
            if (!processInstanceId || !nodeId) {
                const err = new Error('processInstanceId and nodeId are required');
                err.statusCode = 400;
                throw err;
            }

            // usually still live in this container process's memory; if not
            // (e.g. the container restarted since the instance paused),
            // reconstruct it from persistence instead of giving up - see
            // {{ startMethod.name }}ProcessInstanceService.restoreInstance()
            let processInstance = ContainerService.getInstance().processInstances[processInstanceId];
            if (!processInstance) {
                processInstance = await {{ startMethod.name }}ProcessInstanceService.restoreInstance(processInstanceId);
            }
            if (!processInstance) {
                const err = new Error(`process instance ${processInstanceId} was not found or is no longer active`);
                err.statusCode = 404;
                throw err;
            }

            // the incoming flow into this node - WorkflowModel is also how we
            // know nodeId genuinely names a node in this workflow at all.
            const pendingFlow = Object.values(WorkflowModel).find(
                (flow) => flow.target && flow.target.id === nodeId
            );
            if (!pendingFlow) {
                const err = new Error(`node ${nodeId} is not a known node in this workflow`);
                err.statusCode = 404;
                throw err;
            }

            // FlowEvent is the container's own authoritative gate (as
            // before) - the Task record below is a parallel, read-side
            // record for external consumers (Galaxy, other APIs) and isn't
            // what resume behavior is actually gated on.
            const activeFlowEvent = await PersistenceGateway.findActiveFlowEvent({
                processInstanceId,
                flowId: pendingFlow.id,
            });
            if (!activeFlowEvent) {
                const err = new Error(`process instance ${processInstanceId} is not currently waiting at node ${nodeId}`);
                err.statusCode = 409;
                throw err;
            }

            if (body.variables) {
                const variables = typeof body.variables === 'string' ? JSON.parse(body.variables) : body.variables;
                Object.keys(variables).forEach((key) => {
                    if (key in processInstance.variables) {
                        processInstance.variables[key] = variables[key];
                    }
                });
            }

            // atomic (status-conditional) close, not the plain check-then-close
            // above would suggest: a timer intermediate catch event's own
            // resume job (timer.service.js / timer-catch-resume.job.js.njk)
            // can race to resume this exact node at the same moment a caller
            // hits /signal, so the findActiveFlowEvent check above is only a
            // cheap up-front rejection - this is the real claim
            const closedFlowEvent = await PersistenceGateway.closeFlowEventIfActive({processInstanceId, flowId: pendingFlow.id});
            if (!closedFlowEvent) {
                const err = new Error(`process instance ${processInstanceId} is not currently waiting at node ${nodeId}`);
                err.statusCode = 409;
                throw err;
            }
            // keep the external-facing Task record's lifecycle in sync too -
            // best-effort: it's a secondary record, so its absence shouldn't
            // block a resume that FlowEvent already confirmed is legitimate
            await PersistenceGateway.closeTask({processInstanceId, nodeId}).catch((error) => { Logger.error(error); });
            // fire-and-forget, matching bootstrap()'s start call: the /signal
            // response returns immediately while execution continues in the
            // background; a failure is logged rather than surfaced here.
            processInstance[`fn_${nodeId}`]({executeBody: true, id: pendingFlow.id})
                .catch((error) => { Logger.error(error); });

            return {resumed: true, processInstanceId, nodeId};

        } catch (err) {
            Logger.error(err);
            const returnError = new Error();
            returnError.statusCode = err.statusCode || 500;
            returnError.message = err.message || err;
            returnError.stack = err.stack || err;
            throw returnError;
        }
    }

    // Lists every human task currently waiting to be completed, across every
    // process instance in this container — without this, an external caller
    // has no way to discover what nodeId/processInstanceId to pass to
    // /signal. Only HumanTask-typed Task records - a pending catch event is
    // deliberately excluded, it's not something a human "completes" (see
    // GET /tasks vs POST /signal).
    static tasks = async (req, res) => {
        try {
            const activeTasks = await PersistenceGateway.findAllActiveTasks('HumanTask', '{{ ProcessDef }}');
            return activeTasks.map((task) => ({
                processInstanceId: task.processInstance,
                nodeId: task.nodeId,
                nodeName: task.nodeName || task.nodeId,
            }));
        } catch (err) {
            Logger.error(err);
            const returnError = new Error();
            returnError.statusCode = 500;
            returnError.message = err.message || err;
            returnError.stack = err.stack || err;
            throw returnError;
        }
    }
}

export default {{ ControllerClassName }};