{
  "name": "bpmn-designer",
  "version": "1.0.0",
  "description": "A lightweight BPMN designer with pure JavaScript",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "bpmn",
    "diagram",
    "modeler",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "bpmn-moddle": "^9.0.3",
    "moddle-xml": "^11.0.0",
    "monaco-editor": "^0.44.0"
  }
}
